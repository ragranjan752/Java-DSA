package Heap2;

import java.util.PriorityQueue;
import java.util.Collections;

class MedianFinder {

    // Max Heap stores the smaller half of the numbers
    PriorityQueue<Integer> maxHeap =
            new PriorityQueue<>(Collections.reverseOrder());

    // Min Heap stores the larger half of the numbers
    PriorityQueue<Integer> minHeap = new PriorityQueue<>();

    // Constructor
    public MedianFinder() {

    }

    // Adds a number and maintains the heap balance
    public void addNum(int num) {

        // If Max Heap is empty, insert the first number into it
        if (maxHeap.size() == 0) {
            maxHeap.add(num);
        } else {

            // Smaller numbers go into Max Heap
            if (num < maxHeap.peek()) {
                maxHeap.add(num);
            }
            // Larger or equal numbers go into Min Heap
            else {
                minHeap.add(num);
            }
        }

        // If Max Heap has two extra elements, move its maximum to Min Heap
        if (maxHeap.size() == minHeap.size() + 2) {
            minHeap.add(maxHeap.remove());
        }

        // If Min Heap has two extra elements, move its minimum to Max Heap
        if (minHeap.size() == maxHeap.size() + 2) {
            maxHeap.add(minHeap.remove());
        }
    }

    // Returns the median of all inserted numbers
    public double findMedian() {

        // If Max Heap has one extra element, its root is the median
        if (maxHeap.size() == minHeap.size() + 1) {
            return maxHeap.peek();
        }

        // If Min Heap has one extra element, its root is the median
        else if (minHeap.size() == maxHeap.size() + 1) {
            return minHeap.peek();
        }

        // If both heaps have equal sizes, average their roots
        else {
            return (maxHeap.peek() + minHeap.peek()) / 2.0;
        }
    }
}
