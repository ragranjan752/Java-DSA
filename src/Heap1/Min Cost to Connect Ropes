class Solution {
    public int minCost(int[] arr) {
        // code here
        PriorityQueue<Integer> pq = new PriorityQueue<>();
        for(int ele : arr){
            pq.add(ele);
        }
        int cost = 0;
        while(pq.size()>1){
            int first = pq.remove();
            int second = pq.remove();
            int sum = first+second;
            cost += sum;
            pq.add(first+second);
        }
        return cost;
    }
}
